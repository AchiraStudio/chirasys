# Kivo POS & ERP Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials

# Supabase Cloud Project URL
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key
SUPABASE_KEY=your-supabase-anon-key-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: OpenAI API Key for Kivo AI Assistant (Achira AI)
VITE_OPENAI_API_KEY=

# Supabase JWT Secret for signing local access tokens
VITE_SUPABASE_JWT_SECRET=your-jwt-secret-here
